# ---------------------------------------------------------------------------
# gads-agent secrets — copy this file to ".env" and fill in real values.
# NEVER commit .env (it is git-ignored). Nothing secret belongs in config.yaml.
# ---------------------------------------------------------------------------

# --- Required: Google Ads API credentials (all six) ---

# Developer token from your Google Ads manager (MCC) account API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth2 client credentials (Google Cloud Console -> APIs & Services -> Credentials).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# OAuth2 refresh token generated for the client above (offline access).
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) account the developer token belongs to. 10 digits, dashes OK.
# If you operate the account directly (no manager), set this to the SAME value
# as GOOGLE_ADS_CUSTOMER_ID below.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# The Google Ads account the agent reads and (only with --apply) modifies.
GOOGLE_ADS_CUSTOMER_ID=

# --- Optional: pin the Google Ads API version (e.g. v24) for deterministic
#     behavior across library upgrades. Leave blank to use the library's latest.
GOOGLE_ADS_API_VERSION=

# --- Optional: reporting integrations ---
# If a block's vars are blank, that delivery step is silently skipped (no-op).

# Slack incoming webhook URL — posts the daily report summary to a channel.
SLACK_WEBHOOK_URL=

# SMTP email delivery for the daily report (all six needed to enable email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
